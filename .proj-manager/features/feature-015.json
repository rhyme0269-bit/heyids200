{
  "feature_id": "feature-015",
  "name": "DB 驅動計算器系統",
  "description": "將 6 個硬編碼試算器轉為 SQLite + JSON blob 驅動的動態系統。新增 S-expression 公式引擎（支援四則運算、pow、round、abs、min/max、if/比較、tiered 累進稅率）。前端 ToolsClient 從 505 行硬編碼改為 ~240 行泛用渲染器。後台新增「小工具」tab 提供完整 CRUD 管理介面。支援連結型計算器（CalcLink）、條件顯示欄位（showIf）、自動推算欄位、備註內嵌連結。",
  "status": "completed",
  "created_at": "2026-07-30T00:00:00Z",
  "files": [
    "src/lib/calc-types.ts",
    "src/lib/calc-engine.ts",
    "src/lib/calc-seed.ts",
    "src/lib/calc-db.ts",
    "src/lib/db.ts",
    "src/app/tools/page.tsx",
    "src/app/tools/ToolsClient.tsx",
    "src/app/admin/CalcEditor.tsx",
    "src/app/admin/AdminClient.tsx",
    "src/app/api/calculators/route.ts",
    "src/app/api/admin/calculators/route.ts",
    "src/app/api/admin/calculators/[id]/route.ts"
  ],
  "dependencies": [],
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/api/calculators",
      "description": "公開取得可見計算器列表"
    },
    {
      "method": "GET",
      "path": "/api/admin/calculators",
      "description": "管理員取得所有計算器"
    },
    {
      "method": "POST",
      "path": "/api/admin/calculators",
      "description": "新增計算器"
    },
    {
      "method": "PUT",
      "path": "/api/admin/calculators",
      "description": "重新排序計算器"
    },
    {
      "method": "GET",
      "path": "/api/admin/calculators/[id]",
      "description": "取得單一計算器"
    },
    {
      "method": "PUT",
      "path": "/api/admin/calculators/[id]",
      "description": "更新計算器"
    },
    {
      "method": "DELETE",
      "path": "/api/admin/calculators/[id]",
      "description": "刪除計算器（系統預設不可刪）"
    }
  ],
  "data_model": [
    {
      "table": "calculators",
      "columns": [
        "id TEXT PRIMARY KEY",
        "slug TEXT UNIQUE NOT NULL",
        "title TEXT NOT NULL",
        "icon TEXT NOT NULL DEFAULT '🔢'",
        "description TEXT NOT NULL DEFAULT ''",
        "sort_order INTEGER NOT NULL DEFAULT 0",
        "is_system INTEGER NOT NULL DEFAULT 0",
        "is_visible INTEGER NOT NULL DEFAULT 1",
        "definition TEXT NOT NULL DEFAULT '{}'",
        "created_at TEXT NOT NULL",
        "updated_at TEXT NOT NULL"
      ]
    }
  ]
}
