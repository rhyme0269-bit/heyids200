# ===========================================
# 合一地政士事務所 - 環境變數設定
# ===========================================
# 複製此檔案為 .env，然後填入對應的值
# cp .env.example .env
# ===========================================

# --- Docker 連接埠 ---
# 修改這裡就能換 port
HTTP_PORT=8081
HTTPS_PORT=8443

# --- 網域設定 ---
# 本機測試用 localhost，正式上線改成你的網域
DOMAIN=localhost

# --- 網站網址 ---
# 正式上線時改成 https://你的網域
NEXT_PUBLIC_SITE_URL=http://localhost:8081

# --- 後台管理帳號 ---
# 進入 /admin 後台需要輸入帳號和密碼
# 首次啟動時會用這組帳密建立管理員帳號
# 請務必改成自己的帳號密碼！
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
